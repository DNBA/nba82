        <!-- 先發頂部：加入 👁️ 眼睛按鈕 -->
        <div class="flex justify-between w-full items-center">
          <div class="flex items-center gap-1">
            <span class="text-[9px] font-black px-1.5 py-0.2 rounded bg-slate-900 text-amber-400">${pos}</span>
            <button onclick="showPlayerDetails(event, '${player.cardId}')" type="button" class="text-[10px] hover:scale-125 transition cursor-pointer" title="查看數據">👁️</button>
            ${genBadge}
          </div>
          <div class="flex items-center gap-1">
            ${ringBadge}
            ${isOOP ? '<span class="text-[7px] font-bold text-rose-300 bg-rose-950/90 border border-rose-800 px-1 rounded">-5</span>' : ''}
            ${isProtectedByMentor ? '<span class="text-[7px] font-bold text-purple-300 bg-purple-950/90 border border-purple-800 px-1 rounded" title="老將導師庇護：免除錯位懲罰">導師庇護</span>' : ''}
          </div>
        </div>

        <div class="w-10 h-10 rounded-full overflow-hidden bg-slate-900 my-1 pointer-events-none">
          <img src="${getPlayerImgUrl(player.nbaId)}" class="w-full h-full object-cover object-top" onerror="this.src='https://cdn.nba.com/headshots/nba/latest/1040x760/fallback.png'">
        </div>

        <div class="pointer-events-none w-full">
          <p class="font-bold text-[10px] text-white truncate w-full">${player.name}</p>
          <div class="text-[10px] font-mono font-bold ${isOOP ? 'text-rose-400' : 'text-amber-400'}">OVR ${effectiveOvr}</div>
          ${traitsBadges ? `<div class="flex flex-wrap gap-0.5 justify-center mt-0.5">${traitsBadges}</div>` : ''}
