    let marketSortOrder = 'desc';

    function toggleMarketSortOrder() {
      marketSortOrder = (marketSortOrder === 'desc') ? 'asc' : 'desc';
      const btn = document.getElementById('marketSortOrderBtn');
      if (btn) btn.innerText = (marketSortOrder === 'asc') ? '↑ 升序' : '↓ 降序';
      openMarketModal();
