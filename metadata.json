<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToeicQuest NBA - 全能多益備戰與季後賽爭冠系統</title>
<script src="./toeic1000.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .rainbow-glow { box-shadow: 0 0 20px rgba(236, 72, 153, 0.7), inset 0 0 10px rgba(59, 130, 246, 0.5); border-color: #ec4899 !important; }
    .gold-glow { box-shadow: 0 0 18px rgba(245, 158, 11, 0.6), inset 0 0 8px rgba(245, 158, 11, 0.3); border-color: #f59e0b !important; }
    .purple-glow { box-shadow: 0 0 16px rgba(168, 85, 247, 0.5), inset 0 0 6px rgba(168, 85, 247, 0.2); border-color: #a855f7 !important; }
    .silver-black-glow {
      box-shadow: 0 0 24px rgba(226, 232, 240, 0.8), inset 0 0 12px rgba(15, 23, 42, 0.9);
      border-color: #e2e8f0 !important;
      background: linear-gradient(135deg, #090d16 0%, #1e293b 50%, #020617 100%) !important;
    }
    @keyframes gachaGlowPulse {
      0%, 100% { filter: brightness(1); transform: scale(1); }
      50% { filter: brightness(1.18); transform: scale(1.025); }
    }
    .gacha-unrevealed { animation: gachaGlowPulse 1.35s ease-in-out infinite; }
    .gacha-blue-glow { box-shadow: 0 0 16px rgba(59, 130, 246, 0.55), inset 0 0 8px rgba(59, 130, 246, 0.18); }
    .gacha-normal-glow { box-shadow: 0 0 10px rgba(148, 163, 184, 0.25), inset 0 0 6px rgba(148, 163, 184, 0.08); }
    .perspective-1000 { perspective: 1000px; }
    .transform-style-preserve-3d { transform-style: preserve-3d; }
    .backface-hidden { backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }
    @keyframes floatCard { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-6px); } }
    .card-floating { animation: floatCard 2.5s ease-in-out infinite; }
    @keyframes packRip {
      0% { transform: scale(1) rotate(0deg); opacity: 1; }
      40% { transform: scale(1.08) rotate(-2deg); filter: brightness(1.5); }
      70% { transform: scale(0.95) rotate(4deg); opacity: 0.8; }
      100% { transform: scale(1.4) translateY(-100px); opacity: 0; }
    }
    .pack-ripping { animation: packRip 0.75s forwards ease-in-out; }
/* 📜 羊皮紙卷軸展開與收合動畫 */
    @keyframes scrollUnroll {
      0% { transform: scaleY(0.1) scaleX(0.85); opacity: 0; transform-origin: bottom right; }
      70% { transform: scaleY(1.03) scaleX(1.01); }
      100% { transform: scaleY(1) scaleX(1); opacity: 1; transform-origin: bottom right; }
    }
    .scroll-open { animation: scrollUnroll 0.38s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .parchment-border {
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.25), inset 0 0 15px rgba(0, 0, 0, 0.6);
      background: linear-gradient(180deg, #181512 0%, #0f1117 100%);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen pb-24 font-sans selection:bg-amber-500 selection:text-black">

  <!-- 頂部資訊看板 -->
  <header class="bg-slate-900/95 backdrop-blur sticky top-0 z-40 border-b border-slate-800 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center gap-2">
        <i data-lucide="trophy" class="text-amber-400 w-5 h-5"></i>
        <h1 class="text-base font-black bg-gradient-to-r from-amber-400 via-orange-500 to-red-500 bg-clip-text text-transparent">ToeicQuest NBA</h1>
        <span id="onFireBadge" class="hidden text-[10px] bg-amber-500/20 border border-amber-400 text-amber-300 px-2 py-0.5 rounded-full font-bold">
          🔥 ON FIRE (+2 OVR)
        </span>
        <button id="adminBadge" onclick="adminUnlockAllPlayers()" class="hidden text-[10px] bg-red-600/30 hover:bg-red-600/60 border border-red-500 text-red-300 px-2 py-0.5 rounded-full font-bold font-mono transition" title="點擊一鍵獲得所有球員">
          ⚡ ADMIN
        </button>
      </div>

      <div class="flex items-center gap-2 text-xs">
        <div class="flex items-center gap-1 bg-slate-800 px-2.5 py-1 rounded-full border border-slate-700">
          <span class="text-orange-400 font-bold">🔥 <span id="streakCount">1</span>天</span>
        </div>
        <div class="flex items-center gap-1 bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
          <i data-lucide="ticket" class="w-3.5 h-3.5 text-amber-400"></i>
          <span><span id="ticketCount" class="text-amber-400 font-mono font-bold">10</span>張</span>
        </div>
        <div class="flex items-center gap-1 bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
          <i data-lucide="gem" class="w-3.5 h-3.5 text-pink-400"></i>
          <span><span id="scoutPointsCount" class="text-pink-400 font-mono font-bold">0</span>點</span>
        </div>

        <button onclick="openUpgradeModal()" class="flex items-center gap-1 bg-indigo-600/30 hover:bg-indigo-600 text-indigo-300 border border-indigo-500/50 px-2.5 py-1 rounded-full transition text-[11px] font-bold">
          <i data-lucide="star" class="w-3 h-3"></i> 升星所
        </button>
        <button onclick="openMarketModal()" class="flex items-center gap-1 bg-pink-600/30 hover:bg-pink-600 text-pink-300 border border-pink-500/50 px-2.5 py-1 rounded-full transition text-[11px] font-bold">
          <i data-lucide="shopping-bag" class="w-3 h-3"></i> 交易所
        </button>

        <button onclick="openRedeemModal()" class="text-amber-300 p-1 hover:text-white" title="兌換碼"><i data-lucide="gift" class="w-4 h-4"></i></button>
        <button onclick="resetGame()" class="text-rose-400 p-1 hover:text-white" title="重置存檔"><i data-lucide="rotate-ccw" class="w-4 h-4"></i></button>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 mt-4">

    <!-- TAB 1: 🏀 球隊陣容 -->
    <section id="tab-roster" class="tab-content space-y-6">
<!-- 📜 右下角浮動任務卷軸組件 -->
  <!-- 1. 浮動圓形卷軸按鈕 (位於右下角，避開底部導航欄) -->
  <div class="fixed bottom-20 right-4 z-40 flex flex-col items-end">
    <!-- 未領取紅點提醒 -->
    <span id="scrollRedDot" class="hidden absolute -top-1 -right-1 w-3.5 h-3.5 bg-rose-500 rounded-full animate-ping z-50"></span>
    <span id="scrollBadgeCount" class="hidden absolute -top-1.5 -right-1.5 bg-rose-600 text-white font-mono font-black text-[9px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-slate-950 z-50 shadow">!</span>

    <button onclick="toggleQuestScroll()" type="button" id="questScrollTriggerBtn" class="group bg-gradient-to-br from-amber-600 via-amber-700 to-yellow-900 hover:brightness-110 text-amber-100 p-3 rounded-full shadow-2xl border-2 border-amber-400/80 transition-all duration-300 transform active:scale-95 flex items-center gap-1.5 cursor-pointer">
      <span class="text-xl group-hover:rotate-12 transition-transform">📜</span>
      <span class="text-xs font-black tracking-wider pr-1 hidden sm:inline">每日任務</span>
    </button>

    <!-- 2. 展開的羊皮卷軸面板 (點開後從按鈕上方如卷軸般展開) -->
    <div id="questScrollDrawer" class="hidden mt-2 w-[340px] sm:w-[380px] parchment-border border-2 border-amber-500/70 rounded-3xl p-5 shadow-2xl text-slate-100 origin-bottom-right transition-all">
      
      <!-- 卷軸頂部捲軸桿裝飾 -->
      <div class="flex justify-between items-center border-b border-amber-500/30 pb-2.5 mb-3">
        <div class="flex items-center gap-2">
          <span class="text-amber-400 text-base">📜</span>
          <div>
            <h4 class="text-xs font-black text-amber-300 tracking-wider">每日修行卷軸</h4>
            <span class="text-[9px] font-mono text-slate-400">每日 00:00 自動封印換新</span>
          </div>
        </div>
        <button onclick="toggleQuestScroll()" type="button" class="text-slate-400 hover:text-white p-1 text-sm font-bold cursor-pointer">✕</button>
      </div>

      <!-- 任務列表區 -->
<!-- 🎁 每日登入簽到好禮 -->
        <div class="bg-gradient-to-r from-amber-950/60 to-purple-950/60 border border-amber-400/50 p-3 rounded-2xl flex items-center justify-between shadow-lg">
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-[9px] text-amber-300 font-mono font-bold bg-amber-500/20 px-1.5 py-0.2 rounded border border-amber-400/30">DAILY LOGIN</span>
              <span id="loginStreakBadge" class="text-[9px] font-mono text-orange-400 font-bold">連續登入 1 天</span>
            </div>
            <h5 class="text-xs font-black text-white mt-0.5">每日登入福利禮包</h5>
            <div class="text-[10px] font-mono text-amber-400">
              獎勵: <span class="font-bold text-amber-300 font-black">10 🎟️ 抽卡券</span>
            </div>
          </div>
          <button id="claimDailyLoginBtn" onclick="claimDailyLoginReward()" type="button" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-black px-3.5 py-1.5 rounded-xl text-xs transition cursor-pointer shadow-lg animate-pulse">
            領取 10 🎟️
          </button>
        </div>
      <div class="space-y-2.5 max-h-[55vh] overflow-y-auto pr-1">
        <!-- 任務 1 -->
        <div class="bg-slate-950/80 border border-amber-500/20 p-3 rounded-2xl flex items-center justify-between">
          <div>
            <span class="text-[9px] text-amber-400/80 font-mono block">QUEST 01</span>
            <h5 class="text-xs font-bold text-slate-200">登錄 10 個多益單字</h5>
            <div class="text-[10px] font-mono text-amber-400 mt-0.5">
              獎勵: 30 💎 ｜ <span id="q1StatusText" class="text-slate-400 font-bold">0/10</span>
            </div>
          </div>
          <button id="q1ClaimBtn" onclick="claimQuestReward(1)" type="button" class="bg-slate-800 text-slate-500 font-bold px-3 py-1.5 rounded-xl text-[10px] cursor-not-allowed" disabled>
            未達成
          </button>
        </div>

        <!-- 任務 2 -->
        <div class="bg-slate-950/80 border border-amber-500/20 p-3 rounded-2xl flex items-center justify-between">
          <div>
            <span class="text-[9px] text-amber-400/80 font-mono block">QUEST 02</span>
            <h5 class="text-xs font-bold text-slate-200">10 題測驗拿下滿分</h5>
            <div class="text-[10px] font-mono text-amber-400 mt-0.5">
              獎勵: 30 💎 ｜ <span id="q2StatusText" class="text-slate-400 font-bold">未完成</span>
            </div>
          </div>
          <button id="q2ClaimBtn" onclick="claimQuestReward(2)" type="button" class="bg-slate-800 text-slate-500 font-bold px-3 py-1.5 rounded-xl text-[10px] cursor-not-allowed" disabled>
            未達成
          </button>
        </div>

        <!-- 任務 3 -->
        <div class="bg-slate-950/80 border border-amber-500/20 p-3 rounded-2xl flex items-center justify-between">
          <div>
            <span class="text-[9px] text-amber-400/80 font-mono block">QUEST 03</span>
            <h5 class="text-xs font-bold text-slate-200">完成 1 次 25分番茄鐘</h5>
            <div class="text-[10px] font-mono text-amber-400 mt-0.5">
              獎勵: 40 💎 ｜ <span id="q3StatusText" class="text-slate-400 font-bold">0/1 次</span>
            </div>
          </div>
          <button id="q3ClaimBtn" onclick="claimQuestReward(3)" type="button" class="bg-slate-800 text-slate-500 font-bold px-3 py-1.5 rounded-xl text-[10px] cursor-not-allowed" disabled>
            未達成
          </button>
        </div>
      </div>

      <!-- 卷軸底端：全解大獎勵 -->
      <div class="mt-3 pt-3 border-t border-amber-500/30 flex justify-between items-center">
        <div>
          <span class="text-[10px] text-slate-400 block font-mono">卷軸進度</span>
          <span id="questsProgressText" class="text-xs font-black font-mono text-amber-400">0 / 3 達成</span>
        </div>
        <button id="claimAllQuestsBtn" onclick="claimAllQuestsBonus()" type="button" class="bg-slate-800 text-slate-500 font-bold px-4 py-2 rounded-xl text-xs cursor-not-allowed transition" disabled>
          全解送 5 🎟️
        </button>
      </div>

    </div>
  </div>      <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-950 p-5 rounded-3xl border border-indigo-900/40 shadow-xl">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-2">
          <div>
            <h2 class="text-base font-black text-white flex items-center gap-2">
              <i data-lucide="shield-check" class="text-amber-400 w-4 h-4"></i> 球隊陣容 (5 先發 + 6 替補)
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">錯位先發懲罰 -5 OVR ｜ 同隊滿 3 人化學反應 +1 OVR</p>
          </div>
          <div class="flex items-center gap-3">
            <button onclick="autoSetHighestOvrLineup()" class="bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-black px-3 py-1.5 rounded-xl shadow transition flex items-center gap-1">
              <i data-lucide="zap" class="w-3.5 h-3.5"></i> 一鍵最佳陣容
            </button>
            <div id="chemistryBadge" class="text-xs bg-indigo-900/40 border border-indigo-500/40 px-2.5 py-1 rounded-lg text-indigo-300 font-mono">化學反應: +0 OVR</div>
            <div class="text-right">
              <div class="text-[10px] text-slate-400 uppercase font-mono">Team Overall</div>
              <div id="teamOvrBadge" class="text-xl font-black text-amber-400 font-mono leading-none">OVR 0</div>
            </div>
          </div>
        </div>

        <div class="mb-4">
          <div class="text-xs font-bold text-amber-400 mb-2">⭐️ 先發五人陣容 (Starting 5)</div>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5" id="rosterStarters"></div>
        </div>

        <div>
          <div class="text-xs font-bold text-indigo-300 mb-2">🛡️ 板凳深度 (Bench 6)</div>
          <div class="grid grid-cols-2 sm:grid-cols-6 gap-2" id="rosterBench"></div>
        </div>
      </div>

      <!-- 球員背包庫 -->
      <div class="bg-slate-900 p-5 rounded-3xl border border-slate-800 shadow">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <i data-lucide="users" class="text-amber-400 w-4 h-4"></i> 球員卡片庫 (自動整合最高星級)
            </h3>
            <p class="text-xs text-slate-400">重複卡片請至「升星所」突破升級或「交易所」轉化碎片</p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <div class="flex flex-wrap items-center gap-1.5 text-xs">
              <!-- 位置篩選 -->
              <select id="filterPosition" onchange="changeFilter('pos', this.value)" class="bg-slate-950 border border-slate-700 text-slate-200 px-2 py-1 rounded-xl focus:outline-none cursor-pointer">
                <option value="ALL">全部位置</option>
                <option value="PG">PG</option>
                <option value="SG">SG</option>
                <option value="SF">SF</option>
                <option value="PF">PF</option>
                <option value="C">C</option>
              </select>

              <!-- 球隊篩選 -->
              <select id="filterTeam" onchange="changeFilter('team', this.value)" class="bg-slate-950 border border-slate-700 text-slate-200 px-2 py-1 rounded-xl focus:outline-none cursor-pointer">
                <option value="ALL">全部球隊</option>
              </select>

              <!-- 稀有度篩選 -->
              <select id="filterRarity" onchange="changeFilter('rarity', this.value)" class="bg-slate-950 border border-slate-700 text-slate-200 px-2 py-1 rounded-xl focus:outline-none cursor-pointer">
                <option value="ALL">全部稀有度</option>
                <option value="UR">UR</option>
                <option value="SSR">SSR</option>
                <option value="SR">SR</option>
                <option value="R">R</option>
                <option value="N">N</option>
              </select>

              <!-- 排序欄位 -->
              <select id="sortSelector" onchange="changeSortField(this.value)" class="bg-slate-950 border border-slate-700 text-amber-300 font-bold px-2 py-1 rounded-xl focus:outline-none cursor-pointer">
                <option value="ovr">總評 (OVR)</option>
                <option value="recent">獲得時間</option>
                <option value="position">球員位置</option>
                <option value="rarity">稀有度</option>
                <option value="name">姓名</option>
              </select>

              <!-- 升降序切換 -->
              <button id="sortOrderBtn" onclick="toggleSortOrder()" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-amber-400 px-2.5 py-1 rounded-xl font-mono font-bold transition">
                ↓ 降序
              </button>
            </div>

            <button onclick="openBinderModal()" class="flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1 rounded-xl text-xs font-bold shadow transition">
              <i data-lucide="book-marked" class="w-3.5 h-3.5"></i> 30隊圖鑑冊
            </button>
            <span id="inventoryCount" class="text-xs font-mono bg-slate-800 px-3 py-1 rounded-full text-amber-400 border border-slate-700">0 張</span>
          </div>
        </div>

        <div id="cardInventory" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-3 max-h-[480px] overflow-y-auto pr-1"></div>
      </div>
    </section>

    <!-- TAB 2: 🏆 82場例行賽 -->
    <section id="tab-season" class="tab-content space-y-6 hidden">
      <div class="bg-gradient-to-b from-slate-900 to-slate-950 p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-xl text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-xs text-amber-400 mb-3">
          <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
          <span id="seasonLimitTip">每日限挑戰 1 次 ｜ 82-GAME SIMULATION</span>
        </div>
        <h2 class="text-xl font-black text-white">2026 例行賽 82 場即時模擬</h2>
        <p class="text-slate-400 text-xs max-w-md mx-auto mt-1">戰績達 42 勝以上自動解鎖 16 強季後賽對戰圖表！</p>

        <div class="max-w-xl mx-auto my-5 bg-slate-950/80 border border-slate-800 rounded-2xl p-5 text-center shadow-inner">
          <div class="flex justify-between items-center text-xs text-slate-400 font-mono mb-1">
            <span>2025-26 REGULAR SEASON</span>
            <span id="seasonStreakBadge" class="text-amber-400 font-bold">最長連勝: 0 場</span>
          </div>
          <div id="seasonRecordText" class="text-4xl sm:text-5xl font-black text-amber-400 font-mono my-2 tracking-tight">-- 勝 -- 敗</div>
          <div class="flex justify-center items-center gap-2 text-xs text-slate-400">
            <span id="seasonRankText">預估分區排名: --</span>
            <span>•</span>
          </div>
        </div>

        <div id="boxScoreSection" class="max-w-xl mx-auto mb-6 bg-slate-900/80 border border-slate-800 rounded-2xl p-4 text-left hidden">
          <h4 class="text-xs font-black uppercase text-amber-400 font-mono mb-2 flex items-center gap-1.5">
            <i data-lucide="award" class="w-4 h-4"></i> 2025-26 隊內數據領袖 (Box Score Leaders)
          </h4>
          <div id="boxScoreLeadersList" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5 text-xs font-mono"></div>
        </div>

        <div class="flex justify-center gap-3">
          <button id="simSeasonBtn" onclick="start82GamesSimulation()" class="bg-emerald-600 hover:bg-emerald-500 active:scale-95 transition text-white font-black px-6 py-3 rounded-2xl text-sm shadow-lg">
            🏀 開始模擬 82 場比賽
          </button>
          <button id="playoffBtn" onclick="openPlayoffBracketModal()" class="hidden bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 text-slate-950 font-black px-6 py-3 rounded-2xl text-sm shadow-lg">
            🏆 進入 16 強季後賽對戰圖表
          </button>
        </div>

        <div class="mt-6 pt-5 border-t border-slate-800 text-left">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-bold text-slate-300 font-mono">82-GAME TRACKER</span>
          </div>
          <div id="gameGrid" class="grid grid-cols-10 sm:grid-cols-14 md:grid-cols-21 gap-1.5 p-3 bg-slate-950/90 rounded-2xl border border-slate-800/80"></div>
        </div>
      </div>
    </section>
<!-- 👇👇👇 請直接貼在 </section> 的前一行（或緊接在下方） 👇👇👇 -->

<!-- 🌟 全明星週末（第 41 場）榮譽結算彈窗 -->
<div id="allStarEventModal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
  <div class="bg-slate-900 border border-amber-500/60 rounded-3xl w-full max-w-md p-6 shadow-2xl text-center space-y-4 relative">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-400/40 text-xs font-mono font-bold">
      ★ 2026 NBA ALL-STAR WEEKEND ★
    </div>
    <h3 class="text-xl font-black text-white">例行賽半程：全明星盛典！</h3>
