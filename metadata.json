    }

    const borderClass = player.isLegend ? 'silver-black-glow border-slate-200' : getRarityBorder(player.rarity);

    let genBadge = '';
    if (player.isMentor) {
      genBadge = `<span class="text-[7px] font-mono font-black bg-purple-900/90 text-purple-200 border border-purple-500/60 px-1 rounded">MENTOR</span>`;
