    /* =====================================================
       ⑧ SIMULATION & BATTLE SYSTEM
    ===================================================== */
function getTodayString() {
  const d = new Date();
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

    function simulateGame(teamOvr, oppOvr) {
      const win = Math.random() < (0.5 + (teamOvr - oppOvr) * 0.035);
      let myScore = Math.floor(100 + Math.random() * 20 + (teamOvr - 80));
      let oppScore = Math.floor(100 + Math.random() * 20 + (oppOvr - 80));
      if (win && myScore <= oppScore) myScore = oppScore + Math.floor(Math.random() * 6 + 1);
      if (!win && myScore >= oppScore) oppScore = myScore + Math.floor(Math.random() * 6 + 1);
      return { win, myScore, oppScore };
    }

    // 👇👇👇 請直接替換整段 start82GamesSimulation 👇👇👇
let pendingTradeContext = null;
    let isSimPausedForEvent = false;
let seasonStatsTracker = []; // 👈 加入這行
    let games = [];

    function resumeSimFromEvent(modalId) {
      document.getElementById(modalId).classList.add('hidden');
      isSimPausedForEvent = false; // 解除暫停，讓跑馬燈繼續跑
    }

function acceptTradeOffer() {
      if (!pendingTradeContext) return;
      const { giveCard, targetPlayer, lineupRole, lineupSlot } = pendingTradeContext;

      // 1. 產生新球員卡並加入背包
      const newCard = createCard(targetPlayer, 1);
      addCard(newCard);

      // 2. 原地頂替先發或替補席位
      if (lineupRole === 'starter') {
        state.startingLineup[lineupSlot] = newCard;
      } else if (lineupRole === 'bench') {
        state.benchLineup[lineupSlot] = newCard;
      }

      // 3. 從背包中移除被交易送出的舊球員
      removeCardById(giveCard.cardId);

      // 🔥 關鍵修正：若交易的是先發球員，立即同步更換第 55 場之後的所有比賽數據
      if (lineupRole === 'starter' && typeof seasonStatsTracker !== 'undefined') {
        const tracker = seasonStatsTracker.find(t => t.player.name === giveCard.name);
        if (tracker) {
          tracker.player = newCard;
          tracker.trait = getPlayerArchetype(newCard);
          tracker.ovr = Number(newCard.ovr || newCard.baseOvr || 75);
        }

        // 把已預先算好的第 55~81 場 Box Score 中的舊球員替換成新球員
        if (typeof games !== 'undefined' && games.length >= 82) {
          for (let g = 54; g < 82; g++) {
            const box = games[g].boxScore;
            const pBox = box.find(p => p.name === giveCard.name);
            if (pBox) {
              pBox.name = newCard.name;
              pBox.trait = getPlayerArchetype(newCard);
            }
          }
        }
      }

      confetti({ particleCount: 100, spread: 70 });
      playSound('flip');
      alert(`🤝 重磅交易達成！\n送出：【${giveCard.name}】(OVR ${giveCard.ovr})\n迎來：【${newCard.name}】(OVR ${newCard.ovr})，已直接安排進隊伍陣容！`);

      saveGame();
      renderAll();
      resumeSimFromEvent('tradeDeadlineModal');
    }// 👇👇👇 直接貼在 acceptTradeOffer 的下方 👇👇👇
    function rejectTradeOffer() {
      // 1. 關閉交易彈窗
      const modal = document.getElementById('tradeDeadlineModal');
      if (modal) modal.classList.add('hidden');

      // 2. 清空暫存交易資料
      pendingTradeContext = null;

      // 3. 解除暫停，讓跑馬燈繼續往下跑到 82 場
      isSimPausedForEvent = false;

      alert("🚫 已婉拒交易提案，陣容保持不變！");
    }
    function start82GamesSimulation() {
      if (isSimulating) return;
      const today = getTodayString();
      if (!state.isAdmin && state.season.lastSimDate === today) {
playSound('buzz'); //
        alert("今天已經進行過例行賽模擬囉！");
        return;
      }
playSound('whistle');
      const starters = ['PG', 'SG', 'SF', 'PF', 'C'].map(pos => state.startingLineup[pos]).filter(Boolean);
      if (starters.length < 5) {
        alert("⚠️ 先發五人陣容尚未補齊！請先至「陣容」頁面安排完整 5 位先發球員！");
        return;
      }

      const teamOvr = calculateTeamOverall().overall;
      isSimulating = true;
state.season.hasPlayedPlayoffs = false;
      const games = [];
      let simulatedWins = 0, maxS = 0, curS = 0;

      // 1. 計算先發平均 OVR，用來判斷是否有「單一超巨鶴立雞群」
      const starterOvrs = starters.map(p => Number(p.ovr || p.baseOvr || 75));
      const avgStarterOvr = starterOvrs.reduce((a, b) => a + b, 0) / 5;

      const seasonStatsTracker = starters.map(p => {
        const trait = getPlayerArchetype(p);
        const ovr = Number(p.ovr || p.baseOvr || 75);

        // 🌟「大包大攬」係數：當球員高出先發平均時，以指數大幅擴張球權！
        const ovrDiffFromAvg = ovr - avgStarterOvr;
        let alphaMultiplier = 1.0;
        if (ovrDiffFromAvg > 0) {
          alphaMultiplier += Math.pow(ovrDiffFromAvg, 1.4) * 0.08; // 超級球星狂吸球權
        } else {
          alphaMultiplier -= Math.abs(ovrDiffFromAvg) * 0.035; // 綠葉球員讓出球權
        }
        alphaMultiplier = Math.max(0.45, alphaMultiplier);

        return {
          player: p,
          trait: trait,
          ovr: ovr,
          alphaMultiplier: alphaMultiplier,
          seasonFormBonus: (Math.random() * 4) - 2, // 賽季隨機手感
          totalPts: 0,
          totalReb: 0,
          totalAst: 0,
          totalStl: 0,
          totalBlk: 0
        };
      });

      // 模擬 82 場比賽
      for (let i = 0; i < 82; i++) {
        const oppTeam = ALL_30_TEAMS[Math.floor(Math.random() * ALL_30_TEAMS.length)];
        const oppOvr = Math.floor(77 + Math.random() * 16);

        const ovrDiff = teamOvr - oppOvr;
        const winProb = Math.max(0.18, Math.min(0.84, 0.50 + (ovrDiff * 0.028) + (Math.random() * 0.1 - 0.05)));
        const win = Math.random() < winProb;

        if (win) { simulatedWins++; curS++; if (curS > maxS) maxS = curS; } else curS = 0;

        // 全隊真實 NBA 現代單場比分 (102 ~ 124 分)
        const basePaceScore = 110 + Math.round(Math.random() * 12 - 6);
        let myGameScore, oppScore;

        if (win) {
          const margin = Math.floor(Math.random() * 15) + 1;
          myGameScore = basePaceScore + Math.round(ovrDiff * 0.25) + Math.floor(margin / 2);
          oppScore = myGameScore - margin;
        } else {
          const margin = Math.floor(Math.random() * 14) + 1;
          oppScore = basePaceScore - Math.round(ovrDiff * 0.25) + Math.floor(margin / 2);
          myGameScore = oppScore - margin;
        }

        // 板凳火力：約 22 ~ 30 分
        const benchPts = Math.min(32, Math.max(20, Math.round(myGameScore * 0.23 + (Math.random() * 6 - 3))));
        const startersBudget = myGameScore - benchPts;

        // 🌟 計算當場球權權重（球風 × 大包大攬係數 × 當場手感）
        const weights = seasonStatsTracker.map(t => {
          let w = t.ovr * 0.1 * t.alphaMultiplier;
          if (t.trait.type === 'shooter') w *= 1.45;
          else if (t.trait.type === 'slasher') w *= 1.35;
          else if (t.trait.type === 'playmaker') w *= 1.30;
          else if (t.trait.type === 'big_rebound') w *= 0.90;
          else w *= 0.70;
          return w * (0.8 + Math.random() * 0.4); // 當日手感骰子
        });

        const totalW = weights.reduce((a, b) => a + b, 0);
        let allocatedPts = 0;

        // 控球組織核心全場助攻池（先發約瓜分 18 ~ 24 次助攻）
        const teamAstPool = Math.round(18 + Math.random() * 7);
        // 先發籃板池（先發約瓜分 30 ~ 38 個籃板）
        const teamRebPool = Math.round(30 + Math.random() * 8);

        const singleGameBox = seasonStatsTracker.map((tracker, idx) => {
          const p = tracker.player;
          const arch = tracker.trait.type;
          const effOvr = tracker.ovr + tracker.seasonFormBonus;

          // 得分分配：超巨球員得分大爆發
          let pts;
          if (idx === seasonStatsTracker.length - 1) {
            pts = Math.max(2, startersBudget - allocatedPts);
          } else {
            pts = Math.max(3, Math.round((weights[idx] / totalW) * startersBudget));
            allocatedPts += pts;
          }

          // 🏀 擬真籃板分配
          let reb = 0;
          if (arch === 'big_rebound') {
            reb = Math.round((teamRebPool * 0.38) * (tracker.alphaMultiplier > 1.2 ? 1.2 : 1.0) + (Math.random() * 4 - 2));
          } else if (arch === 'slasher' || arch === 'playmaker') {
            reb = Math.round((teamRebPool * 0.16) + (Math.random() * 3 - 1));
          } else {
            reb = Math.round((teamRebPool * 0.11) + (Math.random() * 2 - 1));
          }
          reb = Math.max(1, reb);

          // 🏀 擬真助攻分配
          let ast = 0;
          if (arch === 'playmaker') {
            ast = Math.round((teamAstPool * 0.45) * (tracker.alphaMultiplier > 1.15 ? 1.25 : 1.0) + (Math.random() * 4 - 2));
          } else if (tracker.alphaMultiplier >= 1.3) {
            // 如果某球員 OVR 遠超其他人，即使不是純控衛也會大量策應傳球
            ast = Math.round((teamAstPool * 0.28) + (Math.random() * 3));
          } else {
            ast = Math.round(1 + Math.random() * 3);
          }
          ast = Math.max(0, ast);

          // 🏀 擬真抄截與火鍋
          let stl = 0, blk = 0;
          if (arch === '3d' || tracker.ovr >= 92) stl = Math.random() > 0.45 ? (Math.random() > 0.75 ? 2 : 1) : 0;
          else stl = Math.random() > 0.65 ? 1 : 0;

          if (arch === 'big_rebound' || p.name.includes("Wembanyama") || p.name.includes("Davis")) {
            blk = Math.random() > 0.3 ? (Math.random() > 0.65 ? (Math.random() > 0.85 ? 4 : 3) : 2) : 1;
          } else {
            blk = Math.random() > 0.8 ? 1 : 0;
          }

          // 命中率 (超巨在 48%~58%，射手在 44%~52%)
          const fgPct = Math.min(62, Math.max(38, Math.round(46 + (effOvr - 75) * 0.3 + (Math.random() * 8 - 4))));

          tracker.totalPts += pts;
          tracker.totalReb += reb;
          tracker.totalAst += ast;
          tracker.totalStl += stl;
          tracker.totalBlk += blk;

          return { name: p.name, pos: p.positions[0] || 'G', trait: tracker.trait, pts, reb, ast, stl, blk, fgPct };
        });

        games.push({ win, oppTeam, myScore: myGameScore, oppScore, boxScore: singleGameBox, benchPts });
      }

      // 跑馬燈與結算展示
      let idx = 0;
      const interval = setInterval(() => {
        if (idx >= 82) {
          clearInterval(interval);
          isSimulating = false;
          state.season.lastSimDate = today;
