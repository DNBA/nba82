function renderRoster() {
  const positions = ['PG', 'SG', 'SF', 'PF', 'C'];
  const starContainer = document.getElementById('rosterStarters');
  const benchContainer = document.getElementById('rosterBench');

  const hasMentorOnBench = state.benchLineup.some(p => p && p.isMentor);

  // --- 先發五人陣容 ---
  starContainer.innerHTML = positions.map(pos => {
    const player = state.startingLineup[pos];
    if (!player) {
      return `
        <div ondragover="handleDragOver(event)" 
             ondrop="handleStarterDrop(event, '${pos}')" 
             class="bg-slate-950/80 border-2 border-dashed border-slate-700 hover:border-amber-400 rounded-2xl p-2.5 flex flex-col items-center justify-between text-center min-h-[170px] transition group cursor-pointer">
