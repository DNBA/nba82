  // --- 替補席陣容 ---
  benchContainer.innerHTML = state.benchLineup.map((player, idx) => {
    if (!player) {
      return `
        <div ondragover="handleDragOver(event)" 
             ondrop="handleBenchDrop(event, ${idx})" 
             class="bg-slate-950/60 border-2 border-dashed border-slate-800 hover:border-indigo-400 rounded-xl p-2 flex flex-col items-center justify-between text-center min-h-[145px] transition group cursor-pointer">
          <span class="text-[9px] text-slate-500 font-mono">B${idx+1}</span>
          <div class="text-[9px] text-slate-600 group-hover:text-indigo-300 transition my-auto">拖曳至此</div>
          <span class="text-[8px] text-slate-700">空</span>
